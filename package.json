{
  "name": "frontend-moniter-sdk",
  "private": false,
  "version": "0.1.3",
  "description": "Frontend monitoring SDK.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:server": "npm --workspace server run build",
    "build:platform": "npm --workspace platform run build",
    "build:demo": "npm --workspace demo run build",
    "build:react-demo": "npm --workspace react-demo run build",
    "build:all": "npm run build && npm run build:server && npm run build:platform && npm run build:demo && npm run build:react-demo",
    "dev:server": "npm --workspace server run dev",
    "cleanup": "npm --workspace server run cleanup",
    "dev:platform": "npm --workspace platform run dev",
    "dev:demo": "npm --workspace demo run dev",
    "dev:react-demo": "npm --workspace react-demo run dev",
    "server": "tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "vitest run test/operationalE2E.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "npm --workspace server run typecheck",
    "typecheck:platform": "npm --workspace platform run typecheck",
    "typecheck:demo": "npm --workspace demo run typecheck",
    "typecheck:react-demo": "npm --workspace react-demo run typecheck",
    "typecheck:all": "npm run typecheck && npm run typecheck:server && npm run typecheck:platform && npm run typecheck:demo && npm run typecheck:react-demo",
    "check": "npm run typecheck:all && npm test && npm run build:all",
    "check:sdk": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check:sdk"
  },
  "sideEffects": false,
  "workspaces": [
    "demo",
    "platform",
    "react-demo",
    "server"
  ],
  "dependencies": {
    "error-stack-parser": "^2.1.4",
    "rrweb": "^2.1.7",
    "source-map-js": "^1.2.2",
    "web-vitals": "^6.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "rollup": "^4.52.5",
    "rollup-plugin-dts": "6.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8",
    "vue": "^3.5.43"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "frontend",
    "monitoring",
    "sdk",
    "typescript"
  ]
}
